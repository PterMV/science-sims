<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Uniform Motion — Sim</title>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #fafafa;
      --surface: #ffffff;
      --surface-2: #f4f4f5;
      --border: #e7e7ea;
      --ink: #0a0a0a;
      --ink-2: #3f3f46;
      --ink-3: #71717a;
      --ink-4: #a1a1aa;
      --car-a: oklch(0.52 0.18 250);    /* blue */
      --car-b: oklch(0.65 0.16 30);     /* orange */
      --sans: "Geist", ui-sans-serif, system-ui, -apple-system, sans-serif;
      --mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      font-family: var(--sans);
      background: var(--bg);
      color: var(--ink);
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }
    .sim { display: grid; grid-template-columns: 1fr 320px; height: 100vh; min-height: 600px; }
    @media (max-width: 760px) {
      .sim { grid-template-columns: 1fr; grid-template-rows: minmax(360px, 55vh) 1fr; min-height: 0; }
      .panel { border-left: none; border-top: 1px solid var(--border); }
    }

    .stage {
      position: relative;
      background: linear-gradient(180deg, #f8f8fa 0%, #f0f0f3 100%);
      display: grid;
      grid-template-rows: 1fr 1fr;
      overflow: hidden;
    }

    .scene {
      position: relative;
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      background: #fff;
      display: flex;
      flex-direction: column;
      gap: 14px;
      overflow: hidden;
    }
    .scene-head {
      display: flex; align-items: baseline; justify-content: space-between;
      font-family: var(--mono);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .scene-head .clock {
      color: var(--ink); font-weight: 500; font-size: 12px;
    }
    .track-wrap { display: flex; flex-direction: column; gap: 10px; flex: 1; justify-content: center; }
    .track {
      position: relative;
      height: 56px;
      background: var(--surface-2);
      border-radius: 8px;
      overflow: visible;
    }
    .track-label {
      position: absolute;
      top: -16px; left: 0;
      font-family: var(--mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-3);
      display: flex; align-items: center; gap: 6px;
    }
    .track-label .swatch { width: 10px; height: 10px; border-radius: 3px; }
    .track-readout {
      position: absolute;
      top: -16px; right: 0;
      font-family: var(--mono);
      font-size: 10px;
      color: var(--ink-3);
      letter-spacing: 0.04em;
    }
    .track-readout strong { color: var(--ink); font-weight: 500; }
    .track-ticks {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      display: flex;
      justify-content: space-between;
      padding: 0 2px;
    }
    .track-tick {
      width: 1px;
      background: rgba(0,0,0,0.08);
    }
    .track-tick.major { background: rgba(0,0,0,0.18); }
    .car {
      position: absolute;
      top: 50%;
      width: 44px; height: 24px;
      transform: translate(-50%, -50%);
      border-radius: 4px 8px 4px 4px;
      transition: none;
    }
    .car::before, .car::after {
      content: "";
      position: absolute;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--ink);
      bottom: -4px;
    }
    .car::before { left: 6px; }
    .car::after { right: 6px; }
    .car .windshield {
      position: absolute;
      top: 2px; left: 24px; right: 4px; bottom: 8px;
      background: rgba(255,255,255,0.4);
      border-radius: 2px 4px 1px 1px;
    }

    .graphs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .graph {
      padding: 14px 20px;
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--border);
      background: #fff;
      min-width: 0;
    }
    .graph:last-child { border-right: none; }
    .graph-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 8px;
      font-family: var(--mono);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .graph-head strong { color: var(--ink); font-weight: 500; }
    .graph svg { width: 100%; flex: 1; min-height: 0; }

    /* Panel */
    .panel {
      border-left: 1px solid var(--border);
      background: var(--surface);
      padding: 22px 22px 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      overflow-y: auto;
    }
    .panel-header h2 {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.015em;
    }
    .panel-header p {
      margin: 4px 0 0;
      font-size: 12px;
      color: var(--ink-3);
      line-height: 1.5;
    }
    .ctrl-group {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 14px 16px;
      background: var(--surface-2);
      border-radius: 10px;
    }
    .ctrl-group-head {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ctrl-group-swatch { width: 12px; height: 12px; border-radius: 3px; }
    .ctrl-group-label {
      font-family: var(--mono);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-2);
    }
    .ctrl { display: flex; flex-direction: column; gap: 5px; }
    .ctrl-head {
      display: flex; justify-content: space-between;
      align-items: baseline;
      font-size: 12.5px;
    }
    .ctrl-label { color: var(--ink-2); }
    .ctrl-value {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .ctrl-value .unit { color: var(--ink-3); margin-left: 2px; }
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 4px;
      background: #fff;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px; height: 16px;
      background: var(--ink);
      border-radius: 50%;
      border: 2px solid var(--surface);
      box-shadow: 0 0 0 1px var(--border);
      cursor: grab;
    }
    input[type="range"].thumb-a::-webkit-slider-thumb { background: var(--car-a); }
    input[type="range"].thumb-b::-webkit-slider-thumb { background: var(--car-b); }
    input[type="range"]::-moz-range-thumb {
      width: 16px; height: 16px;
      background: var(--ink);
      border-radius: 50%;
      border: 2px solid var(--surface);
    }

    .btn-row { display: flex; gap: 8px; }
    .btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--ink);
      font-family: inherit;
      cursor: pointer;
    }
    .btn.primary { background: var(--ink); color: white; border-color: var(--ink); }
    .btn:hover { background: var(--surface-2); }
    .btn.primary:hover { background: var(--ink-2); }

    .toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      background: var(--surface-2);
      border-radius: 8px;
      font-size: 12.5px;
      cursor: pointer;
      user-select: none;
    }
    .toggle .switch {
      width: 32px; height: 18px;
      background: var(--border);
      border-radius: 999px;
      position: relative;
      transition: background 0.15s;
    }
    .toggle .switch::after {
      content: "";
      position: absolute;
      top: 2px; left: 2px;
      width: 14px; height: 14px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.15s;
      box-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }
    .toggle.on .switch { background: var(--ink); }
    .toggle.on .switch::after { transform: translateX(14px); }

    /* Tip */
    .tip {
      background: var(--surface-2);
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 12px;
      color: var(--ink-2);
      line-height: 1.55;
      border-left: 3px solid var(--ink);
    }
    .tip strong { color: var(--ink); font-weight: 600; }
  </style>
</head>
<body>
  <div class="sim">
    <div class="stage">
      <div class="scene">
        <div class="scene-head">
          <span>Two cars · uniform motion</span>
          <span class="clock">t = <span id="t-out">0.0</span> s</span>
        </div>
        <div class="track-wrap">
          <div class="track" id="track-a">
            <div class="track-label"><span class="swatch" style="background: var(--car-a)"></span> Car A</div>
            <div class="track-readout">x<sub>A</sub> = <strong><span id="xa-out">0</span></strong> m</div>
            <div class="track-ticks" id="ticks-a"></div>
            <div class="car" id="car-a" style="background: var(--car-a); left: 0%;">
              <div class="windshield"></div>
            </div>
          </div>
          <div class="track" id="track-b">
            <div class="track-label"><span class="swatch" style="background: var(--car-b)"></span> Car B</div>
            <div class="track-readout">x<sub>B</sub> = <strong><span id="xb-out">0</span></strong> m</div>
            <div class="track-ticks" id="ticks-b"></div>
            <div class="car" id="car-b" style="background: var(--car-b); left: 0%;">
              <div class="windshield"></div>
            </div>
          </div>
        </div>
        <div style="font-family: var(--mono); font-size: 10.5px; color: var(--ink-4); text-transform: uppercase; letter-spacing: 0.06em; display: flex; justify-content: space-between;">
          <span>0 m</span><span id="track-mid">25 m</span><span id="track-end">50 m</span>
        </div>
      </div>

      <div class="graphs">
        <div class="graph">
          <div class="graph-head">
            <strong>x – t  ·  Position–Time</strong>
            <span>slope = velocity</span>
          </div>
          <svg id="graph-xt" viewBox="0 0 360 180" preserveAspectRatio="none"></svg>
        </div>
        <div class="graph">
          <div class="graph-head">
            <strong>v – t  ·  Velocity–Time</strong>
            <span>area = displacement</span>
          </div>
          <svg id="graph-vt" viewBox="0 0 360 180" preserveAspectRatio="none"></svg>
        </div>
      </div>
    </div>

    <aside class="panel">
      <div class="panel-header">
        <h2>Uniform Motion Builder</h2>
        <p>Set the track length, each car's starting position and velocity, and watch position-time and velocity-time graphs draw themselves.</p>
      </div>

      <div class="ctrl-group">
        <div class="ctrl-group-head">
          <span class="ctrl-group-swatch" style="background: var(--ink)"></span>
          <span class="ctrl-group-label">Track</span>
        </div>
        <div class="ctrl">
          <div class="ctrl-head">
            <span class="ctrl-label">Distance</span>
            <span class="ctrl-value"><span id="d-out">50</span><span class="unit">m</span></span>
          </div>
          <input type="range" id="d-input" min="20" max="2000" step="10" value="50" />
        </div>
      </div>

      <div class="ctrl-group">
        <div class="ctrl-group-head">
          <span class="ctrl-group-swatch" style="background: var(--car-a)"></span>
          <span class="ctrl-group-label">Car A</span>
          <span style="margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--ink-3)">v<sub>A</sub>, x<sub>0A</sub></span>
        </div>
        <div class="ctrl">
          <div class="ctrl-head">
            <span class="ctrl-label">Velocity</span>
            <span class="ctrl-value"><span id="va-out">5.0</span><span class="unit">m/s</span></span>
          </div>
          <input type="range" id="va-input" class="thumb-a" min="-20" max="20" step="0.5" value="5" />
        </div>
        <div class="ctrl">
          <div class="ctrl-head">
            <span class="ctrl-label">Start position</span>
            <span class="ctrl-value"><span id="xa0-out">0</span><span class="unit">m</span></span>
          </div>
          <input type="range" id="xa0-input" class="thumb-a" min="0" max="50" step="1" value="0" />
        </div>
      </div>

      <div class="ctrl-group">
        <div class="ctrl-group-head">
          <span class="ctrl-group-swatch" style="background: var(--car-b)"></span>
          <span class="ctrl-group-label">Car B</span>
          <span style="margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--ink-3)">v<sub>B</sub>, x<sub>0B</sub></span>
        </div>
        <div class="ctrl">
          <div class="ctrl-head">
            <span class="ctrl-label">Velocity</span>
            <span class="ctrl-value"><span id="vb-out">-3.0</span><span class="unit">m/s</span></span>
          </div>
          <input type="range" id="vb-input" class="thumb-b" min="-20" max="20" step="0.5" value="-3" />
        </div>
        <div class="ctrl">
          <div class="ctrl-head">
            <span class="ctrl-label">Start position</span>
            <span class="ctrl-value"><span id="xb0-out">50</span><span class="unit">m</span></span>
          </div>
          <input type="range" id="xb0-input" class="thumb-b" min="0" max="50" step="1" value="50" />
        </div>
      </div>

      <div>
        <div style="font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-4); margin-bottom: 6px;">Quick scenarios</div>
        <div class="btn-row" style="gap: 6px;">
          <button class="btn" data-preset="same" style="font-size: 12px; padding: 8px 10px;">→ Same way</button>
          <button class="btn" data-preset="toward" style="font-size: 12px; padding: 8px 10px;">↔ Head-on</button>
          <button class="btn" data-preset="chase" style="font-size: 12px; padding: 8px 10px;">→→ Chase</button>
        </div>
      </div>

      <div class="toggle on" id="show-b-toggle">
        <span>Show Car B</span>
        <span class="switch"></span>
      </div>

      <div class="btn-row">
        <button class="btn primary" id="play-btn">▶ Play</button>
        <button class="btn" id="reset-btn">↺ Reset</button>
      </div>

      <div class="tip">
        <strong>For uniform motion</strong>, velocity is constant, so the v–t graph is flat
        and the x–t graph is a straight line whose <em>slope</em> equals the velocity.
        Where the two x–t lines cross, the cars meet.
      </div>
    </aside>
  </div>

  <script>
    // ── Constants ─────────────────────────────────────────
    const V_RANGE = 20;           // m/s shown on v-axis
    const G_W = 360, G_H = 180;
    const G_PAD = { l: 32, r: 8, t: 12, b: 22 };
    const PLOT_W = G_W - G_PAD.l - G_PAD.r;
    const PLOT_H = G_H - G_PAD.t - G_PAD.b;

    // state.T_MAX is dynamic: scales with track distance so cars can complete
    // their journey, clamped to a reasonable window.
    function computeTMax(D) {
      return Math.max(10, Math.min(120, D / 4));
    }

    // ── State ─────────────────────────────────────────────
    const state = {
      D: 50,                      // track distance (m)
      T_MAX: 10,                  // dynamic time window (s)
      vA: 5, vB: -3,
      x0A: 0, x0B: 50,            // starting positions
      xA: 0, xB: 50,              // current positions
      t: 0,
      mode: "ready", // ready | running | done
      showB: true,
      lastFrame: 0,
      raf: null,
      firstFrame: true,
    };
    state.T_MAX = computeTMax(state.D);

    const $ = (id) => document.getElementById(id);

    // ── Tick marks on tracks ──────────────────────────────
    function buildTicks() {
      for (const id of ["ticks-a", "ticks-b"]) {
        const wrap = $(id);
        wrap.innerHTML = "";
        for (let i = 0; i <= 10; i++) {
          const t = document.createElement("div");
          t.className = "track-tick" + (i % 5 === 0 ? " major" : "");
          wrap.appendChild(t);
        }
      }
    }

    // ── Graph rendering ───────────────────────────────────
    function gridAndAxes(svg, xMax, yRange, xLabel, yLabel, yMinusZero = false) {
      // yRange: { min, max }
      const { min: yMin, max: yMax } = yRange;
      svg.innerHTML = "";
      const NS = "http://www.w3.org/2000/svg";

      const xToPx = (x) => G_PAD.l + (x / xMax) * PLOT_W;
      const yToPx = (y) => G_PAD.t + ((yMax - y) / (yMax - yMin)) * PLOT_H;

      // Grid + labels (x)
      const xStep = niceStep(xMax, 5);
      for (let x = 0; x <= xMax + xStep * 0.4; x += xStep) {
        const line = document.createElementNS(NS, "line");
        line.setAttribute("x1", xToPx(x)); line.setAttribute("x2", xToPx(x));
        line.setAttribute("y1", G_PAD.t); line.setAttribute("y2", G_H - G_PAD.b);
        line.setAttribute("stroke", "rgba(0,0,0,0.05)");
        svg.appendChild(line);
        const lbl = document.createElementNS(NS, "text");
        lbl.setAttribute("x", xToPx(x)); lbl.setAttribute("y", G_H - G_PAD.b + 14);
        lbl.setAttribute("text-anchor", "middle");
        lbl.setAttribute("fill", "var(--ink-4)");
        lbl.setAttribute("font-family", "var(--mono)");
        lbl.setAttribute("font-size", "9.5");
        lbl.textContent = x.toFixed(0);
        svg.appendChild(lbl);
      }

      // Grid + labels (y)
      const yStep = niceStep(yMax - yMin, 4);
      for (let y = Math.ceil(yMin / yStep) * yStep; y <= yMax; y += yStep) {
        const line = document.createElementNS(NS, "line");
        line.setAttribute("x1", G_PAD.l); line.setAttribute("x2", G_W - G_PAD.r);
        line.setAttribute("y1", yToPx(y)); line.setAttribute("y2", yToPx(y));
        line.setAttribute("stroke", y === 0 ? "rgba(0,0,0,0.25)" : "rgba(0,0,0,0.05)");
        svg.appendChild(line);
        const lbl = document.createElementNS(NS, "text");
        lbl.setAttribute("x", G_PAD.l - 5); lbl.setAttribute("y", yToPx(y) + 3);
        lbl.setAttribute("text-anchor", "end");
        lbl.setAttribute("fill", "var(--ink-4)");
        lbl.setAttribute("font-family", "var(--mono)");
        lbl.setAttribute("font-size", "9.5");
        lbl.textContent = y.toFixed(0);
        svg.appendChild(lbl);
      }

      // Axis labels
      const xL = document.createElementNS(NS, "text");
      xL.setAttribute("x", G_W - G_PAD.r); xL.setAttribute("y", G_H - 4);
      xL.setAttribute("text-anchor", "end");
      xL.setAttribute("fill", "var(--ink-3)");
      xL.setAttribute("font-family", "var(--mono)");
      xL.setAttribute("font-size", "9.5");
      xL.textContent = xLabel;
      svg.appendChild(xL);

      const yL = document.createElementNS(NS, "text");
      yL.setAttribute("x", 4); yL.setAttribute("y", G_PAD.t + 4);
      yL.setAttribute("fill", "var(--ink-3)");
      yL.setAttribute("font-family", "var(--mono)");
      yL.setAttribute("font-size", "9.5");
      yL.textContent = yLabel;
      svg.appendChild(yL);

      return { xToPx, yToPx };
    }

    function niceStep(range, target) {
      const raw = range / target;
      const pow = Math.pow(10, Math.floor(Math.log10(raw)));
      const norm = raw / pow;
      const step = norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10;
      return step * pow;
    }

    function drawLine(svg, pts, color, width = 2) {
      const NS = "http://www.w3.org/2000/svg";
      if (pts.length < 2) return;
      const d = pts.map((p, i) => (i === 0 ? "M" : "L") + p[0].toFixed(1) + " " + p[1].toFixed(1)).join(" ");
      const path = document.createElementNS(NS, "path");
      path.setAttribute("d", d);
      path.setAttribute("stroke", color);
      path.setAttribute("stroke-width", width);
      path.setAttribute("fill", "none");
      path.setAttribute("stroke-linecap", "round");
      path.setAttribute("stroke-linejoin", "round");
      svg.appendChild(path);
    }

    function drawDot(svg, x, y, color, r = 4) {
      const NS = "http://www.w3.org/2000/svg";
      const c = document.createElementNS(NS, "circle");
      c.setAttribute("cx", x); c.setAttribute("cy", y); c.setAttribute("r", r);
      c.setAttribute("fill", color);
      c.setAttribute("stroke", "#fff"); c.setAttribute("stroke-width", "1.5");
      svg.appendChild(c);
    }

    // ── Compute graph data ────────────────────────────────
    function xAtT(x0, v, t) {
      return x0 + v * t; // uniform motion: x = x0 + v*t
    }

    function xTPoints(x0, v) {
      const pts = [];
      const N = 60;
      for (let i = 0; i <= N; i++) {
        const t = (i / N) * state.T_MAX;
        pts.push({ t, x: xAtT(x0, v, t) });
      }
      return pts;
    }

    // Solve for meeting time (where xA == xB): x0A + vA*t = x0B + vB*t
    function meetingTime() {
      if (!state.showB) return null;
      const dv = state.vA - state.vB;
      if (Math.abs(dv) < 1e-6) return null;
      const tm = (state.x0B - state.x0A) / dv;
      if (tm < 1e-6 || tm > state.T_MAX) return null;
      // Only count the meeting if it actually happens on the track
      const xMeet = xAtT(state.x0A, state.vA, tm);
      if (xMeet < 0 || xMeet > state.D) return null;
      return tm;
    }

    // ── Render full state ─────────────────────────────────
    function render() {
      // Update track distance read-out
      $("track-mid").textContent = (state.D / 2).toFixed(0) + " m";
      $("track-end").textContent = state.D.toFixed(0) + " m";
      // Update car positions
      placeCar("car-a", state.xA, state.vA);
      placeCar("car-b", state.xB, state.vB);
      $("xa-out").textContent = state.xA.toFixed(1);
      $("xb-out").textContent = state.xB.toFixed(1);
      $("t-out").textContent = state.t.toFixed(1);

      drawGraphs();
    }

    function placeCar(id, x, v) {
      // Clamp into track bounds visually
      const pct = Math.max(0, Math.min(100, (x / state.D) * 100));
      const el = $(id);
      el.style.left = pct + "%";
      // Flip horizontally when moving (or aimed) leftward, so the car "faces" its direction.
      const flipped = v < 0;
      el.style.transform = `translate(-50%, -50%) scaleX(${flipped ? -1 : 1})`;
    }

    function drawGraphs() {
      const xtSvg = $("graph-xt");
      const vtSvg = $("graph-vt");

      // X-T graph: y range covers both cars across the time window, plus 0 and D
      const xExtremes = [
        xAtT(state.x0A, state.vA, 0), xAtT(state.x0A, state.vA, state.T_MAX),
        state.showB ? xAtT(state.x0B, state.vB, 0) : 0,
        state.showB ? xAtT(state.x0B, state.vB, state.T_MAX) : 0,
        0, state.D,
      ];
      let xMax = Math.max(...xExtremes);
      let xMin = Math.min(...xExtremes);
      // Add headroom
      const pad = Math.max(2, (xMax - xMin) * 0.08);
      const xt = gridAndAxes(xtSvg, state.T_MAX, { min: Math.floor(xMin - pad), max: Math.ceil(xMax + pad) }, "t (s)", "x (m)");

      // Track-edge guide lines (0 and D)
      const NS = "http://www.w3.org/2000/svg";
      [0, state.D].forEach(y => {
        const line = document.createElementNS(NS, "line");
        line.setAttribute("x1", xt.xToPx(0)); line.setAttribute("x2", xt.xToPx(state.T_MAX));
        line.setAttribute("y1", xt.yToPx(y)); line.setAttribute("y2", xt.yToPx(y));
        line.setAttribute("stroke", "rgba(0,0,0,0.18)");
        line.setAttribute("stroke-dasharray", "2 3");
        xtSvg.appendChild(line);
      });

      // Draw full-trajectory ghost lines (faint)
      drawLine(xtSvg, xTPoints(state.x0A, state.vA).map(p => [xt.xToPx(p.t), xt.yToPx(p.x)]), "var(--car-a)", 1.2);
      if (state.showB) {
        drawLine(xtSvg, xTPoints(state.x0B, state.vB).map(p => [xt.xToPx(p.t), xt.yToPx(p.x)]), "var(--car-b)", 1.2);
      }
      // Meeting-point marker (only when both shown)
      if (state.showB) {
        const tm = meetingTime();
        if (tm !== null) {
          const xm = xAtT(state.x0A, state.vA, tm);
          // Only show if within track bounds
          if (xm >= -1 && xm <= state.D + 1) {
            const px = xt.xToPx(tm), py = xt.yToPx(xm);
            // crosshairs
            const v = document.createElementNS(NS, "line");
            v.setAttribute("x1", px); v.setAttribute("x2", px);
            v.setAttribute("y1", G_PAD.t); v.setAttribute("y2", G_H - G_PAD.b);
            v.setAttribute("stroke", "rgba(10,10,10,0.4)");
            v.setAttribute("stroke-dasharray", "2 3");
            xtSvg.appendChild(v);
            const c = document.createElementNS(NS, "circle");
            c.setAttribute("cx", px); c.setAttribute("cy", py);
            c.setAttribute("r", 4);
            c.setAttribute("fill", "#0a0a0a");
            c.setAttribute("stroke", "#fff");
            c.setAttribute("stroke-width", "1.5");
            xtSvg.appendChild(c);
            const lbl = document.createElementNS(NS, "text");
            lbl.setAttribute("x", px + 6); lbl.setAttribute("y", py - 6);
            lbl.setAttribute("fill", "var(--ink)");
            lbl.setAttribute("font-family", "var(--mono)");
            lbl.setAttribute("font-size", "9.5");
            lbl.textContent = "meet · " + tm.toFixed(1) + "s, " + xm.toFixed(0) + "m";
            xtSvg.appendChild(lbl);
          }
        }
      }
      // Highlight the played portion + dot
      if (state.t > 0) {
        drawLine(xtSvg,
          xTPoints(state.x0A, state.vA).filter(p => p.t <= state.t).map(p => [xt.xToPx(p.t), xt.yToPx(p.x)]),
          "var(--car-a)", 2.5);
        drawDot(xtSvg, xt.xToPx(state.t), xt.yToPx(state.xA), "var(--car-a)");
        if (state.showB) {
          drawLine(xtSvg,
            xTPoints(state.x0B, state.vB).filter(p => p.t <= state.t).map(p => [xt.xToPx(p.t), xt.yToPx(p.x)]),
            "var(--car-b)", 2.5);
          drawDot(xtSvg, xt.xToPx(state.t), xt.yToPx(state.xB), "var(--car-b)");
        }
      }

      // V-T graph
      const vtAxes = gridAndAxes(vtSvg, state.T_MAX, { min: -V_RANGE, max: V_RANGE }, "t (s)", "v (m/s)");
      // Constant velocity line: full
      drawLine(vtSvg,
        [[vtAxes.xToPx(0), vtAxes.yToPx(state.vA)], [vtAxes.xToPx(state.T_MAX), vtAxes.yToPx(state.vA)]],
        "var(--car-a)", 1.2);
      if (state.showB) {
        drawLine(vtSvg,
          [[vtAxes.xToPx(0), vtAxes.yToPx(state.vB)], [vtAxes.xToPx(state.T_MAX), vtAxes.yToPx(state.vB)]],
          "var(--car-b)", 1.2);
      }

      // Highlight area under v-t up to current t (= displacement)
      if (state.t > 0) {
        // Area for A
        const x0 = vtAxes.xToPx(0), x1 = vtAxes.xToPx(state.t);
        const yA = vtAxes.yToPx(state.vA);
        const yZero = vtAxes.yToPx(0);
        const rectA = document.createElementNS(NS, "path");
        rectA.setAttribute("d", `M${x0} ${yZero} L${x0} ${yA} L${x1} ${yA} L${x1} ${yZero} Z`);
        rectA.setAttribute("fill", "var(--car-a)");
        rectA.setAttribute("fill-opacity", "0.15");
        vtSvg.appendChild(rectA);

        // Active velocity line
        drawLine(vtSvg, [[x0, yA], [x1, yA]], "var(--car-a)", 2.5);
        drawDot(vtSvg, x1, yA, "var(--car-a)");

        if (state.showB) {
          const yB = vtAxes.yToPx(state.vB);
          const rectB = document.createElementNS(NS, "path");
          rectB.setAttribute("d", `M${x0} ${yZero} L${x0} ${yB} L${x1} ${yB} L${x1} ${yZero} Z`);
          rectB.setAttribute("fill", "var(--car-b)");
          rectB.setAttribute("fill-opacity", "0.15");
          vtSvg.appendChild(rectB);
          drawLine(vtSvg, [[x0, yB], [x1, yB]], "var(--car-b)", 2.5);
          drawDot(vtSvg, x1, yB, "var(--car-b)");
        }
      }
    }

    // ── Stop conditions ──────────────────────────────────
    // First time a car reaches the track boundary [0, D].
    function boundaryHitTime() {
      let best = null;
      const cars = [
        { x0: state.x0A, v: state.vA },
        state.showB ? { x0: state.x0B, v: state.vB } : null,
      ].filter(Boolean);
      for (const c of cars) {
        if (Math.abs(c.v) < 1e-9) continue;
        // Solve x0 + v*t = D  and  x0 + v*t = 0
        for (const target of [0, state.D]) {
          const t = (target - c.x0) / c.v;
          if (t > 1e-6 && t <= state.T_MAX + 1e-6) {
            if (best === null || t < best) best = t;
          }
        }
      }
      return best;
    }
    // Stop time = earliest of: boundary hit, meeting time, T_MAX
    function stopTime() {
      const candidates = [state.T_MAX];
      const tm = meetingTime();
      if (tm !== null && tm > 1e-6) candidates.push(tm);
      const tb = boundaryHitTime();
      if (tb !== null) candidates.push(tb);
      return Math.min(...candidates);
    }

    // ── Animation ─────────────────────────────────────────
    function step(now) {
      if (state.mode !== "running") return;
      if (state.firstFrame) {
        state.firstFrame = false;
        state.lastFrame = now;
        state.raf = requestAnimationFrame(step);
        return;
      }
      const dt = Math.max(0, Math.min(0.05, (now - state.lastFrame) / 1000));
      state.lastFrame = now;
      state.t += dt;
      const tStop = stopTime();
      if (state.t >= tStop) {
        state.t = tStop;
        state.mode = "done";
        $("play-btn").innerHTML = "▶ Play";
      }
      state.xA = xAtT(state.x0A, state.vA, state.t);
      state.xB = xAtT(state.x0B, state.vB, state.t);
      // Clamp into track bounds for display
      state.xA = Math.max(0, Math.min(state.D, state.xA));
      state.xB = Math.max(0, Math.min(state.D, state.xB));
      render();
      if (state.mode === "running") {
        state.raf = requestAnimationFrame(step);
      }
    }

    function play() {
      if (state.mode === "running") {
        cancelAnimationFrame(state.raf);
        state.mode = "ready";
        $("play-btn").innerHTML = "▶ Resume";
        return;
      }
      if (state.mode === "done" || state.t >= state.T_MAX) {
        // Replay
        state.t = 0; state.xA = state.x0A; state.xB = state.x0B;
      }
      state.mode = "running";
      state.firstFrame = true;
      $("play-btn").innerHTML = "⏸ Pause";
      state.raf = requestAnimationFrame(step);
    }

    function reset() {
      cancelAnimationFrame(state.raf);
      state.mode = "ready";
      state.t = 0;
      state.xA = state.x0A; state.xB = state.x0B;
      $("play-btn").innerHTML = "▶ Play";
      render();
    }

    // ── Bindings ──────────────────────────────────────────
    function clampX0Inputs() {
      $("xa0-input").max = state.D;
      $("xb0-input").max = state.D;
      if (state.x0A > state.D) {
        state.x0A = state.D;
        $("xa0-input").value = state.D;
        $("xa0-out").textContent = state.D.toFixed(0);
      }
      if (state.x0B > state.D) {
        state.x0B = state.D;
        $("xb0-input").value = state.D;
        $("xb0-out").textContent = state.D.toFixed(0);
      }
    }

    $("d-input").addEventListener("input", (e) => {
      state.D = parseFloat(e.target.value);
      $("d-out").textContent = state.D.toFixed(0);
      state.T_MAX = computeTMax(state.D);
      clampX0Inputs();
      if (state.mode !== "running") {
        state.xA = xAtT(state.x0A, state.vA, state.t);
        state.xB = xAtT(state.x0B, state.vB, state.t);
        render();
      }
    });

    $("va-input").addEventListener("input", (e) => {
      state.vA = parseFloat(e.target.value);
      $("va-out").textContent = state.vA.toFixed(1);
      if (state.mode !== "running") {
        state.xA = xAtT(state.x0A, state.vA, state.t);
        render();
      }
    });
    $("vb-input").addEventListener("input", (e) => {
      state.vB = parseFloat(e.target.value);
      $("vb-out").textContent = state.vB.toFixed(1);
      if (state.mode !== "running") {
        state.xB = xAtT(state.x0B, state.vB, state.t);
        render();
      }
    });
    $("xa0-input").addEventListener("input", (e) => {
      state.x0A = parseFloat(e.target.value);
      $("xa0-out").textContent = state.x0A.toFixed(0);
      // moving start position resets the run
      state.t = 0;
      state.mode = "ready";
      $("play-btn").innerHTML = "▶ Play";
      state.xA = state.x0A;
      render();
    });
    $("xb0-input").addEventListener("input", (e) => {
      state.x0B = parseFloat(e.target.value);
      $("xb0-out").textContent = state.x0B.toFixed(0);
      state.t = 0;
      state.mode = "ready";
      $("play-btn").innerHTML = "▶ Play";
      state.xB = state.x0B;
      render();
    });

    // Presets
    function applyPreset(name) {
      const D = state.D;
      cancelAnimationFrame(state.raf);
      state.mode = "ready";
      state.t = 0;
      $("play-btn").innerHTML = "▶ Play";
      if (name === "same") {
        // Both leaving from A, different speeds
        state.x0A = 0; state.vA = 4;
        state.x0B = 0; state.vB = 6;
      } else if (name === "toward") {
        // Head-on: A at 0 going right, B at D going left
        state.x0A = 0; state.vA = 5;
        state.x0B = D; state.vB = -3;
      } else if (name === "chase") {
        // Chase: A ahead, B behind catching up
        state.x0A = Math.round(D * 0.4); state.vA = 3;
        state.x0B = 0; state.vB = 7;
      }
      // Sync inputs
      $("va-input").value = state.vA; $("va-out").textContent = state.vA.toFixed(1);
      $("vb-input").value = state.vB; $("vb-out").textContent = state.vB.toFixed(1);
      $("xa0-input").value = state.x0A; $("xa0-out").textContent = state.x0A.toFixed(0);
      $("xb0-input").value = state.x0B; $("xb0-out").textContent = state.x0B.toFixed(0);
      state.xA = state.x0A; state.xB = state.x0B;
      render();
    }
    document.querySelectorAll("[data-preset]").forEach(btn => {
      btn.addEventListener("click", () => applyPreset(btn.dataset.preset));
    });

    $("show-b-toggle").addEventListener("click", () => {
      state.showB = !state.showB;
      $("show-b-toggle").classList.toggle("on", state.showB);
      $("car-b").style.display = state.showB ? "block" : "none";
      $("track-b").style.opacity = state.showB ? "1" : "0.25";
      render();
    });
    $("play-btn").addEventListener("click", play);
    $("reset-btn").addEventListener("click", reset);

    // ── Initial render ────────────────────────────────────
    buildTicks();
    render();
  </script>
</body>
</html>
